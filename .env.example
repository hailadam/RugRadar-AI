# Optional: GoPlus may require an access token depending on your plan/usage.
# GOPLUS_API_KEY=your_token_here
# Optional local database location. On Community Cloud, local files are ephemeral.
# RUGRADAR_DB_PATH=data/rugradar.db

# Optional read-only blockchain providers. Use endpoints for the matching mainnet.
# Leave unset to report blockchain checks as not configured.
# BASE_RPC_URL=
# ETHEREUM_RPC_URL=
# BSC_RPC_URL=
# ARBITRUM_RPC_URL=
# OPTIMISM_RPC_URL=
# POLYGON_RPC_URL=
# AVALANCHE_RPC_URL=
# SOLANA_RPC_URL=
